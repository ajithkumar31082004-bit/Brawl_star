# AWS Region
aws_region   = "ap-south-1"
project_name = "battleverse"
environment  = "prod"

# Networking
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidr   = "10.0.1.0/24"
private_subnet_cidrs = ["10.0.2.0/24", "10.0.3.0/24"]
admin_cidr           = "0.0.0.0/0" # For production, restrict to your IP e.g. "203.0.113.50/32"

# Compute (EC2)
instance_type = "t3.micro"
ec2_key_name  = "battleverse-key"

# Database (RDS MySQL)
db_name              = "battleverse_db"
db_username          = "battleverse_admin"
db_password          = "ChangeMeToStrongPassword123!"
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20

# Notifications (SNS)
notification_email = "ajithkumar31082004@gmail.com"
