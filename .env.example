# BATTLEVERSE Environment Variables Example

# Client Configuration
VITE_APP_TITLE=BATTLEVERSE — 3V3 Hero Arena
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Server / Backend Configuration (Node.js Express)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=super_secret_battleverse_jwt_key_2026

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=battleverse_secure_password
DB_NAME=battleverse_db

# Redis Cache / Session
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
